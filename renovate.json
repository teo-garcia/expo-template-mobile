{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>teo-garcia/templates//renovate/active"],
  "packageRules": [
    {
      "description": "Keep Expo SDK-coupled packages together and require compatibility review",
      "groupName": "Expo SDK compatibility set",
      "matchPackageNames": [
        "expo",
        "/^expo-/",
        "react",
        "react-dom",
        "react-native",
        "/^react-native-/",
        "jest-expo",
        "react-test-renderer",
        "nativewind"
      ],
      "dependencyDashboardApproval": true,
      "reviewers": ["teo-garcia"]
    }
  ]
}
